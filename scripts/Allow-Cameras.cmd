@echo off
set "CT_MONITOR_DIR=%~dp0"
echo Run as administrator. Read config.json beside this file to update camera FTP firewall rules.
powershell -NoProfile -Command "$ErrorActionPreference='Stop'; $file=Join-Path $env:CT_MONITOR_DIR 'config.json'; if (!(Test-Path -LiteralPath $file)) { $file=Join-Path $env:CT_MONITOR_DIR 'config.example.json' }; $cfg=Get-Content -LiteralPath $file -Raw -Encoding UTF8 | ConvertFrom-Json; $entries=@($cfg.cameras | Where-Object { $_.enabled -ne $false }); $rules=@(); foreach ($cam in $entries) { $ip=[System.Net.IPAddress]::Parse($cam.ip); if ($ip.AddressFamily -ne [System.Net.Sockets.AddressFamily]::InterNetwork) { throw 'IPv4 required' }; $port=if ($null -eq $cam.ftp_port) { [int]$cfg.ftp_port } else { [int]$cam.ftp_port }; if ($port -lt 1 -or $port -gt 65535 -or ($port -ge 30000 -and $port -le 30010)) { throw 'Invalid FTP port' }; $rules+=@{IP=$ip.ToString();Port=$port} }; Get-NetFirewallRule -Group 'ChingTech Rust Monitor' -ErrorAction SilentlyContinue | Remove-NetFirewallRule; foreach ($entry in $rules) { New-NetFirewallRule -DisplayName ('ChingTech FTP '+$entry.IP+':'+$entry.Port) -Group 'ChingTech Rust Monitor' -Direction Inbound -Action Allow -Protocol TCP -LocalPort $entry.Port,30000-30010 -RemoteAddress $entry.IP | Out-Null }; Write-Host 'Camera FTP firewall rules updated.'"
if errorlevel 1 echo Failed. Check administrator rights and configuration.
pause
